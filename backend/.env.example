# Local development. Copy to .env, or run ..\setup.ps1.
# Inventory and local PDF extraction do not need an API key.
STATE_BACKEND=sqlite
AUTO_RESEARCH_ENABLED=false
PUBLIC_DATASHEET_CONSENT=false
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3-flash-preview,gemini-flash-lite-latest
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
